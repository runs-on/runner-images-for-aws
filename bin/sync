#!/usr/bin/env ruby
  
require 'fileutils'
require 'tmpdir'
require 'yaml'
require 'slop'

IMAGES = YAML.load_file(File.expand_path("../config.yml", __dir__)).fetch("images")
UPSTREAM = YAML.safe_load_file(File.expand_path("../upstream.lock.yml", __dir__))

options = {}

usage = Slop::Options.new do |opts|
  opts.banner = "Usage: #{$0} [--image-id IMAGE_ID] [--dist-prefix PREFIX]"
  opts.string '--image-id', 'Image ID', required: false
  opts.string '--dist-prefix', 'Only sync images whose dist starts with this prefix (e.g. ubuntu, windows)', required: false
end

begin
  options = usage.parse(ARGV).to_hash
rescue Slop::Error => e
  puts "Error: #{e.message}"
  puts
  puts usage
  exit 1
end

workspace = Dir.mktmpdir
repo_dir = File.join(workspace, 'repo')

begin
  repository = UPSTREAM.fetch("repository")
  revision = UPSTREAM.fetch("revision")
  fail("Invalid locked upstream revision: #{revision}") unless revision.match?(/\A[0-9a-f]{40}\z/)

  system("git", "init", "-q", repo_dir) || fail("Failed to initialize upstream checkout")
  system("git", "-C", repo_dir, "remote", "add", "origin", repository) || fail("Failed to configure upstream checkout")
  system("git", "-C", repo_dir, "fetch", "-q", "--depth", "1", "origin", revision) || fail("Failed to fetch locked upstream revision #{revision}")
  system("git", "-C", repo_dir, "checkout", "-q", "--detach", "FETCH_HEAD") || fail("Failed to check out locked upstream revision #{revision}")

  puts "Using #{repository}@#{revision}"
  IMAGES.each do |image|
    if options[:image_id] && image['id'] != options[:image_id]
      next
    end
    if options[:dist_prefix] && !image['id'].start_with?(options[:dist_prefix])
      next
    end

    puts "Syncing #{image['id']}..."
    image_id_parts = image['id'].split('-')
    fail("Invalid image id: #{image['id']}") if image_id_parts.length < 3

    dist = image_id_parts.first
    arch = image_id_parts.last
    variant = image_id_parts[1..-2].join('-')
    release_dir = "releases/#{dist}/#{arch}"
    FileUtils.rm_rf(release_dir)
    FileUtils.mkdir_p(release_dir)
    FileUtils.cp_r("#{repo_dir}/.", release_dir)
    ['.git', '.github', 'docs', '.vscode', 'images.CI', '.gitignore', '.gitattributes', 'CODE_OF_CONDUCT.md', 'CONTRIBUTING.md', 'SECURITY.md'].each do |useless_dir|
      FileUtils.rm_rf("#{release_dir}/#{useless_dir}")
    end
    ['images/macos', 'images/windows', 'images/ubuntu'].each do |useless_dir|
      FileUtils.rm_rf("#{release_dir}/#{useless_dir}") unless useless_dir =~ %r{#{dist.sub(/[0-9]+/, '')}}
    end

    system("./bin/patch/#{dist}-#{arch} #{release_dir}") || fail("Failed to patch #{release_dir}")
    puts "OK"
  end
ensure
  FileUtils.rm_rf(workspace)
end
