options = {}

usage = Slop::Options.new do |opts|
  opts.banner = "Usage: #{$0} AMI_NAME_OR_ID [options]"
  opts.string '--instance-type', 'Instance type override'
  opts.string '--region', 'AWS region', default: ENV['AWS_REGION'] || ENV['AWS_DEFAULT_REGION'] || 'us-east-1'
  opts.string '--subnet-id', 'Subnet to launch into'
  opts.string '--ssh-user', 'SSH username', default: 'ubuntu'
  opts.integer '--ssh-timeout', 'Max seconds to wait for SSH login', default: 600
  opts.string '--output-json', 'Write the complete benchmark result to this path'
  opts.integer '--root-iops', 'Override root gp3 IOPS'
  opts.integer '--root-initialization-rate', 'Provisioned snapshot initialization rate in MiB/s (100-300)'
  opts.integer '--root-throughput', 'Override root gp3 throughput in MiB/s'
  opts.integer '--root-volume-size', 'Override root volume size in GiB'
  opts.integer '--warm-runs', 'Warm-up launches before measurement', default: 3
  opts.integer '--measure-runs', 'Measured launches after warm-up', default: 3
  opts.string '--require-average-rolaunch-ready-at-most', 'Fail unless measured rolaunch mean is at most this many seconds'
  opts.string '--require-max-rolaunch-ready-below', 'Fail unless every measured rolaunch time is below this many seconds'
  opts.bool '--verify-compact-recovery', 'Reboot one measured instance and verify the compact GRUB recovery path'
  opts.bool '-h', '--help', 'Show help'
end

begin
  options = usage.parse(ARGV).to_hash
  options[:ami_name_or_id] = ARGV.shift
rescue Slop::Error => e
  warn "Error: #{e.message}"
  warn
  warn usage
  exit 1
end

if options[:help] || options[:ami_name_or_id].nil?
  puts usage
  exit(options[:help] ? 0 : 1)
end

if options[:root_initialization_rate] && !(100..300).cover?(options[:root_initialization_rate])
  warn "--root-initialization-rate must be between 100 and 300 MiB/s"
  exit 1
end

if options[:warm_runs].negative?
  warn "--warm-runs must be zero or greater"
  exit 1
end

if options[:measure_runs] <= 0
  warn "--measure-runs must be greater than zero"
  exit 1
end

{
  require_average_rolaunch_ready_at_most: '--require-average-rolaunch-ready-at-most',
  require_max_rolaunch_ready_below: '--require-max-rolaunch-ready-below'
}.each do |key, flag|
  next unless options[key]

  begin
    threshold = BigDecimal(options[key])
  rescue ArgumentError
    threshold = nil
  end
  unless threshold&.finite? && threshold.positive?
    warn "#{flag} must be a finite positive number"
    exit 1
  end
  options[key] = threshold
end

def linux_user_data(ssh_user:, public_key:)
  requested_user = ssh_user.to_s.strip
  unless requested_user.match?(/\A[a-zA-Z0-9_][a-zA-Z0-9_.-]*\z/)
    raise "invalid ssh username #{requested_user.inspect}"
  end
  requested_user = requested_user.shellescape
  <<~EOS
    #!/bin/bash
    set -euxo pipefail

    if ! id -u '#{requested_user}' >/dev/null 2>&1; then
      SSH_USER='root'
    else
      SSH_USER='#{requested_user}'
    fi

    if [ "$SSH_USER" = "root" ]; then
      ssh_home='/root/.ssh'
      ssh_owner='root:root'
    else
      ssh_home="/home/$SSH_USER/.ssh"
      ssh_owner="$SSH_USER:$SSH_USER"
    fi

    install -d -m 700 "$ssh_home"
    cat > "$ssh_home/authorized_keys" <<'EOF'
    #{public_key}
    EOF
    chown "$ssh_owner" "$ssh_home" "$ssh_home/authorized_keys"
    chmod 600 "$ssh_home/authorized_keys"

    systemctl unmask ssh.service || true
    systemctl enable ssh.service || true
    systemctl start ssh.service || true
    date --utc '+%Y-%m-%dT%H:%M:%S.%NZ' > /run/runs-on-boot-benchmark-ready
    chmod 0644 /run/runs-on-boot-benchmark-ready
  EOS
end

def find_latest_ami(ec2, ami_name_or_id)
  filters = [{ name: 'state', values: ['available'] }]
  if ami_name_or_id.start_with?('ami-')
    filters << { name: 'image-id', values: [ami_name_or_id] }
  else
    filters << { name: 'name', values: ["#{ami_name_or_id}*"] }
  end

  images = ec2.describe_images(filters: filters).images
  raise "No AMIs found matching #{ami_name_or_id.inspect}" if images.empty?

  images.max_by(&:creation_date)
end

def resolve_instance_type(options, image)
  return options[:instance_type] if options[:instance_type]

  case image.architecture
  when 'arm64'
    'm8g.large'
  when 'x86_64'
    'm7a.large'
  else
    raise "Unsupported architecture #{image.architecture.inspect}"
  end
end

def resolve_subnet(ec2, subnet_id)
  return ec2.describe_subnets(subnet_ids: [subnet_id]).subnets.first if subnet_id

  subnet = ec2.describe_subnets(
    filters: [{ name: 'tag:test', values: ['true'] }]
  ).subnets.first
  raise 'No subnet found with tag test=true' unless subnet

  subnet
end

def current_public_ip
  URI.open('https://checkip.amazonaws.com', &:read).strip
end

def create_temp_security_group(ec2, subnet, caller_ip)
  name = "measure-launch-time-#{Time.now.to_i}-#{rand(1000)}"
  sg = ec2.create_security_group(
    group_name: name,
    description: 'Temporary SSH ingress for AMI launch timing',
    vpc_id: subnet.vpc_id,
    tag_specifications: [
      {
        resource_type: 'security-group',
        tags: [
          { key: 'Name', value: name },
          { key: 'application', value: 'RunsOn' }
        ]
      }
    ]
  )
  begin
    ec2.authorize_security_group_ingress(
      group_id: sg.group_id,
      ip_permissions: [
        {
          ip_protocol: 'tcp',
          from_port: 22,
          to_port: 22,
          ip_ranges: [{ cidr_ip: "#{caller_ip}/32", description: 'measure-launch-time' }]
        }
      ]
    )
  rescue StandardError
    begin
      ec2.delete_security_group(group_id: sg.group_id)
    rescue StandardError => cleanup_error
      warn "Failed to roll back temporary security group #{sg.group_id}: #{cleanup_error.message}"
    end
    raise
  end
  sg.group_id
end

def wait_for_public_ip(ec2, instance_id, timeout_seconds:)
  deadline = Time.now + timeout_seconds
  last_error = nil
  loop do
    begin
      instance = ec2.describe_instances(instance_ids: [instance_id]).reservations.first.instances.first
      if instance.public_ip_address && !instance.public_ip_address.empty?
        return [instance.public_ip_address, instance.launch_time]
      end
    rescue Aws::EC2::Errors::InvalidInstanceIDNotFound => e
      last_error = e
    end

    raise "Timed out waiting for public IP on #{instance_id}: #{last_error}" if Time.now >= deadline

    sleep 2
  end
end

def wait_for_ssh(ip:, ssh_user:, private_key_path:, timeout_seconds:)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
  last_error = nil

  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise "Timed out waiting for SSH on #{ip}: #{last_error}" if remaining <= 0

    begin
      ssh_cmd = [
        'ssh',
        '-o', 'BatchMode=yes',
        '-o', 'IdentitiesOnly=yes',
        '-o', 'StrictHostKeyChecking=no',
        '-o', 'UserKnownHostsFile=/dev/null',
        '-o', 'ConnectTimeout=5',
        '-o', 'ServerAliveInterval=2',
        '-o', 'ServerAliveCountMax=2',
        '-i', private_key_path,
        "#{ssh_user}@#{ip}",
        'true'
      ]
      _stdout, stderr, status = capture3_with_timeout(
        *ssh_cmd,
        timeout_seconds: [remaining, 10].min
      )
      return if status.success?

      last_error = stderr.strip.empty? ? 'ssh exited non-zero' : stderr.strip
    rescue StandardError => e
      last_error = e
    end

    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise "Timed out waiting for SSH on #{ip}: #{last_error}" if remaining <= 0

    sleep [2, remaining].min
  end
end

def ssh_capture(ip:, ssh_user:, private_key_path:, remote_command:, timeout_seconds:)
  command = [
    'ssh',
    '-o', 'BatchMode=yes',
    '-o', 'IdentitiesOnly=yes',
    '-o', 'LogLevel=ERROR',
    '-o', 'StrictHostKeyChecking=no',
    '-o', 'UserKnownHostsFile=/dev/null',
    '-o', 'ConnectTimeout=5',
    '-o', 'ServerAliveInterval=2',
    '-o', 'ServerAliveCountMax=2',
    '-i', private_key_path,
    "#{ssh_user}@#{ip}",
    "bash -lc #{remote_command.shellescape}"
  ]
  capture3_with_timeout(*command, timeout_seconds: timeout_seconds)
end

def compact_recovery_failure(summary, stdout:, stderr:)
  details = []
  details << "Remote checks:\n#{stdout.strip}" unless stdout.strip.empty?
  details << "Remote errors:\n#{stderr.strip}" unless stderr.strip.empty?
  [summary, *details].join("\n")
end

def wait_for_new_boot_id(ip:, ssh_user:, private_key_path:, previous_boot_id:, timeout_seconds:, poll_interval: 2)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
  last_error = nil
  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise "Timed out waiting for recovery reboot on #{ip}: #{last_error}" if remaining <= 0

    begin
      stdout, stderr, status = ssh_capture(
        ip: ip,
        ssh_user: ssh_user,
        private_key_path: private_key_path,
        remote_command: 'cat /proc/sys/kernel/random/boot_id',
        timeout_seconds: [remaining, 10].min
      )
      if status.success?
        boot_id = stdout.strip
        return boot_id if !boot_id.empty? && boot_id != previous_boot_id

        last_error = 'instance still reports the original boot ID'
      else
        last_error = stderr.strip
      end
    rescue StandardError => e
      last_error = e.message
    end

    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise "Timed out waiting for recovery reboot on #{ip}: #{last_error}" if remaining <= 0

    sleep [poll_interval, remaining].min
  end
end

def verify_compact_recovery!(ip:, ssh_user:, private_key_path:, timeout_seconds:, expected_root_gib: nil, nonce: SecureRandom.hex(16))
  marker_path = '/etc/runs-on-compact-recovery-check'
  diagnostic_helpers = <<~SH
    failures=0
    pass_check() {
      printf 'PASS %s: %s\n' "$1" "$2"
    }
    fail_check() {
      printf 'FAIL %s\n  expected: %s\n  actual:   %s\n' "$1" "$2" "$3" >&2
      failures=$((failures + 1))
    }
    check_equal() {
      if [[ "$2" == "$3" ]]; then
        pass_check "$1" "$3"
      else
        fail_check "$1" "$2" "$3"
      fi
    }
    check_empty() {
      if [[ -z "$2" ]]; then
        pass_check "$1" '<empty>'
      else
        fail_check "$1" '<empty>' "$2"
      fi
    }
    check_nonempty() {
      if [[ -n "$2" ]]; then
        pass_check "$1" "$2"
      else
        fail_check "$1" '<nonempty>' '<empty>'
      fi
    }
    check_block_device() {
      if [[ -b "$2" ]]; then
        pass_check "$1" "$2"
      else
        fail_check "$1" '<block device>' "${2:-<empty>}"
      fi
    }
    check_integer() {
      if [[ "$2" =~ ^[0-9]+$ ]]; then
        pass_check "$1" "$2"
      else
        fail_check "$1" '<nonnegative integer>' "${2:-<empty>}"
      fi
    }
    check_le() {
      if (( $2 <= $3 )); then
        pass_check "$1" "$2 <= $3"
      else
        fail_check "$1" "<= $3" "$2"
      fi
    }
    check_ge() {
      if (( $2 >= $3 )); then
        pass_check "$1" "$2 >= $3"
      else
        fail_check "$1" ">= $3" "$2"
      fi
    }
  SH
  prepare = <<~SH
    set -uo pipefail
    #{diagnostic_helpers}
    root_fstype="$(findmnt -nro FSTYPE / 2>&1)"
    boot_path="$(cat /etc/runs-on-overlay/boot-path 2>&1)"
    check_equal 'initial root filesystem type' 'overlay' "$root_fstype"
    check_equal 'initial boot path' 'direct-uefi' "$boot_path"
    if (( failures > 0 )); then
      printf 'Initial compact recovery checks failed: %d check(s) failed\n' "$failures" >&2
      exit 1
    fi
    printf '%s\n' #{nonce.shellescape} | sudo tee #{marker_path.shellescape} >/dev/null
    cat /proc/sys/kernel/random/boot_id
    sudo systemd-run --quiet --collect \
      --unit=runs-on-compact-recovery-reboot \
      --on-active=2s /usr/bin/systemctl reboot
  SH
  stdout, stderr, status = ssh_capture(
    ip: ip,
    ssh_user: ssh_user,
    private_key_path: private_key_path,
    remote_command: prepare,
    timeout_seconds: 30
  )
  unless status.success?
    raise compact_recovery_failure('Unable to schedule compact recovery reboot', stdout: stdout, stderr: stderr)
  end

  previous_boot_id = stdout.lines.map(&:strip).find { |line| line.match?(/\A[0-9a-f-]{36}\z/) }
  raise 'Unable to read the pre-reboot boot ID' unless previous_boot_id

  recovery_boot_id = wait_for_new_boot_id(
    ip: ip,
    ssh_user: ssh_user,
    private_key_path: private_key_path,
    previous_boot_id: previous_boot_id,
    timeout_seconds: timeout_seconds
  )
  root_check = if expected_root_gib
                 <<~SH
                   expected_disk_bytes=$((#{Integer(expected_root_gib)} * 1024 * 1024 * 1024))
                   backing_mount="$(cat /etc/runs-on-overlay/backing-root-mount 2>&1)"
                   backing_source="$(findmnt -nro SOURCE --target "$backing_mount" 2>&1)"
                   resolved_source="$(readlink -f "$backing_source" 2>/dev/null || true)"
                   if [[ ! -b "$resolved_source" ]]; then
                     device_number="$(findmnt -nro MAJ:MIN --target "$backing_mount" 2>&1)"
                     sys_path="$(readlink -f "/sys/dev/block/$device_number" 2>&1)"
                     resolved_source="/dev/${sys_path##*/}"
                   fi
                   parent_name="$(lsblk -nro PKNAME "$resolved_source" 2>&1 | awk 'NF && !found { print; found=1 }')"
                   parent_device="/dev/$parent_name"
                   disk_bytes="$(sudo blockdev --getsize64 "$parent_device" 2>&1)"
                   partition_bytes="$(sudo blockdev --getsize64 "$resolved_source" 2>&1)"
                   block_count="$(sudo tune2fs -l "$resolved_source" 2>&1 | awk -F: '$1 == "Block count" && !found { gsub(/[[:space:]]/, "", $2); print $2; found=1 }')"
                   block_size="$(sudo tune2fs -l "$resolved_source" 2>&1 | awk -F: '$1 == "Block size" && !found { gsub(/[[:space:]]/, "", $2); print $2; found=1 }')"
                   check_nonempty 'backing root mount' "$backing_mount"
                   check_block_device 'backing root partition' "$resolved_source"
                   check_block_device 'backing root disk' "$parent_device"
                   check_integer 'root disk bytes' "$disk_bytes"
                   check_integer 'root partition bytes' "$partition_bytes"
                   check_integer 'root filesystem block count' "$block_count"
                   check_integer 'root filesystem block size' "$block_size"
                   if [[ "$disk_bytes" =~ ^[0-9]+$ ]]; then
                     check_equal 'root disk size' "$expected_disk_bytes" "$disk_bytes"
                   fi
                   if [[ "$disk_bytes" =~ ^[0-9]+$ && "$partition_bytes" =~ ^[0-9]+$ ]]; then
                     check_le 'root partition does not exceed disk' "$partition_bytes" "$disk_bytes"
                     check_ge 'root partition uses the expanded disk' "$partition_bytes" $((disk_bytes - 2 * 1024 * 1024 * 1024))
                   fi
                   if [[ "$partition_bytes" =~ ^[0-9]+$ && "$block_count" =~ ^[0-9]+$ && "$block_size" =~ ^[0-9]+$ ]]; then
                     filesystem_bytes=$((block_count * block_size))
                     check_ge 'root filesystem uses the expanded partition' "$filesystem_bytes" $((partition_bytes - 64 * 1024 * 1024))
                   fi
                 SH
               else
                 ''
               end
  validate = <<~SH
    set -uo pipefail
    #{diagnostic_helpers}
    marker="$(cat #{marker_path.shellescape} 2>&1)"
    root_fstype="$(findmnt -nro FSTYPE / 2>&1)"
    boot_path="$(cat /etc/runs-on-overlay/boot-path 2>&1)"
    check_equal 'persistent marker' #{nonce.shellescape} "$marker"
    check_equal 'recovery root filesystem type' 'overlay' "$root_fstype"
    check_equal 'recovery boot path' 'grub-initramfs-recovery' "$boot_path"
    direct_state=/var/lib/runs-on-direct-uefi
    expected_cmdline="$(cat "$direct_state/expected-recovery-cmdline" 2>&1)"
    actual_cmdline="$(cat /proc/cmdline 2>&1)"
    normalized_cmdline="$(printf '%s\n' "$actual_cmdline" | sed -E 's/(^| )BOOT_IMAGE=[^ ]+ ?/\\1/' | xargs)"
    check_equal 'recovery kernel command line' "$expected_cmdline" "$normalized_cmdline"
    expected_fallback="$(tr '[:lower:]' '[:upper:]' < "$direct_state/fallback-bootnum" 2>&1)"
    expected_order="$(tr '[:lower:]' '[:upper:]' < "$direct_state/expected-boot-order" 2>&1)"
    firmware="$(sudo efibootmgr -v 2>&1)"
    firmware_status=$?
    boot_current="$(awk -F': ' '/^BootCurrent:/ { print toupper($2); exit }' <<< "$firmware")"
    boot_next="$(awk -F': ' '/^BootNext:/ { print toupper($2); exit }' <<< "$firmware")"
    boot_order="$(awk -F': ' '/^BootOrder:/ { print toupper($2); exit }' <<< "$firmware")"
    printf 'EFI state:\n%s\n' "$firmware"
    check_equal 'efibootmgr exit status' '0' "$firmware_status"
    check_equal 'recovery BootCurrent' "$expected_fallback" "$boot_current"
    check_empty 'recovery BootNext' "$boot_next"
    check_equal 'recovery BootOrder' "$expected_order" "$boot_order"
    check_equal 'fallback is first in BootOrder' "$expected_fallback" "${boot_order%%,*}"
    #{root_check}
    printf 'recovery_boot_id=%s\n' #{recovery_boot_id.shellescape}
    printf 'boot_path=%s\n' "$boot_path"
    printf 'boot_order=%s\n' "$boot_order"
    if (( failures > 0 )); then
      printf 'Compact recovery validation failed: %d check(s) failed\n' "$failures" >&2
      exit 1
    fi
  SH
  stdout, stderr, status = ssh_capture(
    ip: ip,
    ssh_user: ssh_user,
    private_key_path: private_key_path,
    remote_command: validate,
    timeout_seconds: 60
  )
  unless status.success?
    raise compact_recovery_failure('Compact recovery validation failed', stdout: stdout, stderr: stderr)
  end

  stdout
end

class RolaunchUnavailable < StandardError; end

def signal_process_group(pid, signal)
  Process.kill(signal, -pid)
rescue Errno::ESRCH
  nil
end

def capture3_with_timeout(*command, timeout_seconds:)
  Open3.popen3(*command, pgroup: true) do |stdin, stdout, stderr, wait_thread|
    stdin.close
    stdout_reader = Thread.new { stdout.read }
    stderr_reader = Thread.new { stderr.read }

    unless wait_thread.join(timeout_seconds)
      signal_process_group(wait_thread.pid, 'TERM')
      unless wait_thread.join(0.5)
        signal_process_group(wait_thread.pid, 'KILL')
        wait_thread.join
      end
      stdout_reader.join
      stderr_reader.join
      raise Timeout::Error, "command timed out after #{timeout_seconds.round(2)}s"
    end

    [stdout_reader.value, stderr_reader.value, wait_thread.value]
  end
end

def read_rolaunch_ready_seconds(ip:, ssh_user:, private_key_path:, timeout_seconds: 30, poll_interval: 0.2)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
  last_error = nil

  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    begin
      return read_rolaunch_ready_seconds_once(
        ip: ip,
        ssh_user: ssh_user,
        private_key_path: private_key_path,
        timeout_seconds: [remaining, 0.1].max
      )
    rescue RolaunchUnavailable
      raise
    rescue StandardError => e
      last_error = e
    end

    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise last_error if remaining <= 0

    sleep [poll_interval, remaining].min
  end
end

def read_rolaunch_ready_seconds_once(ip:, ssh_user:, private_key_path:, timeout_seconds:)
  marker = '---ROLAUNCH-TIMINGS---'
  remote_command = <<~SH
    test -x /usr/bin/rolaunch || exit 44
    sudo -n cat /var/lib/rolaunch/instance-identity.json
    printf '\n#{marker}\n'
    sudo -n cat /var/lib/rolaunch/timings.json
  SH
  ssh_cmd = [
    'ssh',
    '-o', 'BatchMode=yes',
    '-o', 'IdentitiesOnly=yes',
    '-o', 'StrictHostKeyChecking=no',
    '-o', 'UserKnownHostsFile=/dev/null',
    '-o', 'ConnectTimeout=2',
    '-o', 'ServerAliveInterval=2',
    '-o', 'ServerAliveCountMax=2',
    '-i', private_key_path,
    "#{ssh_user}@#{ip}",
    remote_command
  ]
  stdout, stderr, status = capture3_with_timeout(*ssh_cmd, timeout_seconds: timeout_seconds)
  raise RolaunchUnavailable, 'AMI does not use rolaunch' if status.exitstatus == 44
  raise "unable to read rolaunch timing files: #{stderr.strip}" unless status.success?

  identity_json, timings_json = stdout.split(marker, 2).map(&:strip)
  raise 'missing rolaunch timing marker' unless timings_json

  pending_time = Time.iso8601(JSON.parse(identity_json).fetch('pendingTime'))
  done_step = JSON.parse(timings_json).find { |step| step.fetch('Name') == 'rolaunch.done' }
  raise 'missing rolaunch.done timing step' unless done_step

  Time.iso8601(done_step.fetch('Time')) - pending_time
end

def summarize_rolaunch_measurements(measured)
  values = measured.filter_map { |result| result[:rolaunch_ready_s] }
  expected = measured.any? { |result| result[:rolaunch_status] != 'absent' }

  {
    expected: expected,
    complete: !expected || values.length == measured.length,
    values: values,
    average: values.empty? ? nil : values.sum / values.length,
    maximum: values.max
  }
end

def verify_rolaunch_benchmark!(results:, warm_runs:, measure_runs:, average_at_most: nil, max_below: nil)
  return unless average_at_most || max_below

  expected_phases = Array.new(warm_runs, 'warm') + Array.new(measure_runs, 'measure')
  actual_phases = results.map { |result| result[:phase] }
  unless actual_phases == expected_phases
    raise "Rolaunch benchmark run set differs from #{warm_runs} warm and #{measure_runs} measured launches"
  end

  instance_ids = results.map { |result| result[:instance_id].to_s }
  if instance_ids.any?(&:empty?) || instance_ids.uniq.length != instance_ids.length
    raise 'Rolaunch benchmark requires a unique nonempty instance ID for every launch'
  end

  invalid = results.reject do |result|
    value = result[:rolaunch_ready_s]
    parsed = value && BigDecimal(value.to_s)
    result[:rolaunch_status] == 'ready' && parsed&.finite? && parsed >= 0
  rescue ArgumentError
    false
  end
  unless invalid.empty?
    raise "Rolaunch benchmark requires rolaunch.done for every launch; invalid instances: #{invalid.map { |result| result[:instance_id] }.join(', ')}"
  end

  measured_values = results.last(measure_runs).map { |result| BigDecimal(result.fetch(:rolaunch_ready_s).to_s) }
  if average_at_most && measured_values.sum > average_at_most * measured_values.length
    average = measured_values.sum / measured_values.length
    raise "Average rolaunch readiness #{average.to_s('F')}s exceeds #{average_at_most.to_s('F')}s"
  end
  if max_below && measured_values.any? { |value| value >= max_below }
    maximum = measured_values.max
    raise "Maximum rolaunch readiness #{maximum.to_s('F')}s is not below #{max_below.to_s('F')}s"
  end
end

def read_common_ready_seconds(ip:, ssh_user:, private_key_path:, launch_time:, timeout_seconds: 30, poll_interval: 0.2)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
  last_error = nil

  loop do
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    begin
      return read_common_ready_seconds_once(
        ip: ip,
        ssh_user: ssh_user,
        private_key_path: private_key_path,
        launch_time: launch_time,
        timeout_seconds: [remaining, 0.1].max
      )
    rescue StandardError => e
      last_error = e
    end

    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    raise last_error if remaining <= 0

    sleep [poll_interval, remaining].min
  end
end

def read_common_ready_seconds_once(ip:, ssh_user:, private_key_path:, launch_time:, timeout_seconds:)
  remote_command = <<~SH
    set -e
    cat /run/runs-on-boot-benchmark-ready
  SH
  ssh_cmd = [
    'ssh',
    '-o', 'BatchMode=yes',
    '-o', 'IdentitiesOnly=yes',
    '-o', 'StrictHostKeyChecking=no',
    '-o', 'UserKnownHostsFile=/dev/null',
    '-o', 'ConnectTimeout=2',
    '-o', 'ServerAliveInterval=2',
    '-o', 'ServerAliveCountMax=2',
    '-i', private_key_path,
    "#{ssh_user}@#{ip}",
    remote_command
  ]
  stdout, stderr, status = capture3_with_timeout(*ssh_cmd, timeout_seconds: timeout_seconds)
  raise "unable to read common readiness marker: #{stderr.strip}" unless status.success?

  Time.iso8601(stdout.strip) - launch_time
end

def build_keypair(dir)
  private_key = File.join(dir, 'measure-launch-time')
  public_key = "#{private_key}.pub"
  system('ssh-keygen', '-q', '-m', 'PEM', '-t', 'rsa', '-b', '4096', '-N', '', '-f', private_key, out: File::NULL, err: File::NULL) or
    raise 'ssh-keygen failed'
  [private_key, File.read(public_key).strip]
end

def root_block_device_override(image, root_iops:, root_initialization_rate:, root_throughput:, root_volume_size:)
  root = image.block_device_mappings.find do |mapping|
    mapping.device_name == image.root_device_name && mapping.ebs
  end
  raise "Unable to find root block device mapping for #{image.image_id}" unless root

  override = {
    device_name: root.device_name,
    ebs: {
      volume_size: root_volume_size || root.ebs.volume_size,
      volume_type: root.ebs.volume_type,
      delete_on_termination: true
    }
  }
  iops = root_iops || root.ebs.iops
  override[:ebs][:iops] = iops if iops
  override[:ebs][:volume_initialization_rate] = root_initialization_rate if root_initialization_rate
  if root.ebs.volume_type == 'gp3'
    throughput = root_throughput || root.ebs.throughput
    override[:ebs][:throughput] = throughput if throughput
  end
  override
end

def launch_instance(ec2:, image:, instance_type:, subnet:, security_group_id:, user_data:, root_iops:, root_initialization_rate:, root_throughput:, root_volume_size:)
  instance = ec2.run_instances(
    image_id: image.image_id,
    instance_type: instance_type,
    min_count: 1,
    max_count: 1,
    instance_initiated_shutdown_behavior: 'terminate',
    user_data: Base64.encode64(user_data),
    block_device_mappings: [
      root_block_device_override(
        image,
        root_iops: root_iops,
        root_initialization_rate: root_initialization_rate,
        root_throughput: root_throughput,
        root_volume_size: root_volume_size
      )
    ],
    network_interfaces: [
      {
        device_index: 0,
        subnet_id: subnet.subnet_id,
        groups: [security_group_id],
        associate_public_ip_address: true,
        delete_on_termination: true
      }
    ],
    tag_specifications: [
      {
        resource_type: 'instance',
        tags: [
          { key: 'Name', value: 'measure-launch-time' },
          { key: 'application', value: 'RunsOn' }
        ]
      },
      {
        resource_type: 'volume',
        tags: [
          { key: 'Name', value: 'measure-launch-time' },
          { key: 'application', value: 'RunsOn' }
        ]
      }
    ]
  ).instances.first
  instance.instance_id
end

def root_volume_initialization_status(ec2:, instance_id:, root_device_name:)
  instance = ec2.describe_instances(instance_ids: [instance_id]).reservations.first.instances.first
  mapping = instance.block_device_mappings.find { |candidate| candidate.device_name == root_device_name }
  unless mapping&.ebs&.volume_id
    raise "Unable to find root volume mapping #{root_device_name.inspect} for #{instance_id}"
  end

  volume_id = mapping.ebs.volume_id
  volume = ec2.describe_volumes(volume_ids: [volume_id]).volumes.first
  raise "Unable to describe root volume #{volume_id} for #{instance_id}" unless volume

  details = {
    volume_id: volume_id,
    volume_type: volume.volume_type,
    size_gib: volume.size,
    iops: volume.iops,
    throughput_mibps: volume.throughput,
    snapshot_id: volume.snapshot_id,
    provisioned_rate_mibps: volume.volume_initialization_rate
  }

  begin
    status = ec2.describe_volume_status(volume_ids: [volume_id]).volume_statuses.first
    initialization = status&.initialization_status_details
    details.merge!(
      initialization_type: initialization&.initialization_type,
      progress_percent: initialization&.progress,
      estimated_seconds_remaining: initialization&.estimated_time_to_complete_in_seconds
    )
  rescue StandardError => e
    details[:initialization_status_error] = "#{e.class}: #{e.message}"
  end

  details
end

def verify_root_volume_configuration!(details, requested_initialization_rate:, requested_throughput:)
  if requested_initialization_rate && details[:provisioned_rate_mibps] != requested_initialization_rate
    raise "Root volume initialization rate mismatch: requested #{requested_initialization_rate} MiB/s, got #{details[:provisioned_rate_mibps].inspect} (#{details.inspect})"
  end

  if requested_throughput && details[:throughput_mibps] != requested_throughput
    raise "Root volume throughput mismatch: requested #{requested_throughput} MiB/s, got #{details[:throughput_mibps].inspect} (#{details.inspect})"
  end
end

def measure_instance_ssh_ready(ec2:, instance_id:, ssh_user:, private_key_path:, ssh_timeout:)
  launched_at = Time.now
  ip, launch_time = wait_for_public_ip(ec2, instance_id, timeout_seconds: ssh_timeout)
  wait_for_ssh(
    ip: ip,
    ssh_user: ssh_user,
    private_key_path: private_key_path,
    timeout_seconds: ssh_timeout
  )

  [ip, Time.now - launched_at, launch_time]
end

def request_instance_termination(ec2, instance_id)
  ec2.terminate_instances(instance_ids: [instance_id])
rescue Aws::EC2::Errors::InvalidInstanceIDNotFound
  nil
end

def wait_for_instances_terminated(ec2, instance_ids)
  return if instance_ids.empty?

  ec2.wait_until(:instance_terminated, instance_ids: instance_ids)
rescue Aws::EC2::Errors::InvalidInstanceIDNotFound
  nil
end

def terminate_instance_and_wait(ec2, instance_id)
  request_instance_termination(ec2, instance_id)
  wait_for_instances_terminated(ec2, [instance_id])
end

def cleanup_instances(ec2, instance_ids)
  requested_ids = []
  errors = []

  instance_ids.uniq.each do |instance_id|
    begin
      request_instance_termination(ec2, instance_id)
      requested_ids << instance_id
    rescue StandardError => e
      errors << "failed to terminate #{instance_id}: #{e.message}"
    end
  end

  begin
    wait_for_instances_terminated(ec2, requested_ids)
  rescue StandardError => e
    errors << "failed while waiting for instance termination: #{e.message}"
  end

  errors
end

def delete_security_group_with_retry(ec2, security_group_id)
  10.times do |attempt|
    ec2.delete_security_group(group_id: security_group_id)
    return
  rescue Aws::EC2::Errors::ServiceError => e
    raise if attempt == 9

    sleep 3
  end
end

ec2 = Aws::EC2::Client.new(region: options[:region])
image = find_latest_ami(ec2, options[:ami_name_or_id])
raise "This helper only supports Linux AMIs for now (platform=#{image.platform_details.inspect})" if image.platform&.downcase == 'windows'

instance_type = resolve_instance_type(options, image)
subnet = resolve_subnet(ec2, options[:subnet_id])
caller_ip = current_public_ip

Dir.mktmpdir('measure-launch-time') do |dir|
  private_key_path, public_key = build_keypair(dir)
  security_group_id = create_temp_security_group(ec2, subnet, caller_ip)
  launched_instance_ids = []

  begin
    user_data = linux_user_data(
      ssh_user: options[:ssh_user],
      public_key: public_key
    )

    total_runs = options[:warm_runs] + options[:measure_runs]
    results = []
    compact_recovery_verified = false
    compact_recovery_evidence = nil

    puts "AMI: #{image.name} (#{image.image_id})"
    puts "Architecture: #{image.architecture}"
    puts "Instance type: #{instance_type}"
    puts "Region: #{options[:region]}"
    puts "Subnet: #{subnet.subnet_id}"
    puts "Security group: #{security_group_id}"
    if options[:root_iops]
      puts "Root IOPS override: #{options[:root_iops]}"
    else
      puts "Root IOPS: AMI block device mapping"
    end
    if options[:root_initialization_rate]
      puts "Root initialization rate: #{options[:root_initialization_rate]} MiB/s"
    else
      puts "Root initialization rate: AWS default"
    end
    if options[:root_throughput]
      puts "Root throughput override: #{options[:root_throughput]} MiB/s"
    else
      puts "Root throughput: AMI block device mapping"
    end
    if options[:root_volume_size]
      puts "Root volume size override: #{options[:root_volume_size]} GiB"
    else
      puts "Root volume size: AMI block device mapping"
    end
    puts "Warm-up runs: #{options[:warm_runs]}"
    puts "Measured runs: #{options[:measure_runs]}"
    puts "SSH timeout: #{options[:ssh_timeout]}s"
    if options[:require_average_rolaunch_ready_at_most]
      puts "Required rolaunch mean: <= #{options[:require_average_rolaunch_ready_at_most].to_s('F')}s"
    end
    if options[:require_max_rolaunch_ready_below]
      puts "Required rolaunch maximum: < #{options[:require_max_rolaunch_ready_below].to_s('F')}s"
    end
    puts 'Compact GRUB recovery check: enabled' if options[:verify_compact_recovery]

    total_runs.times do |idx|
      phase = idx < options[:warm_runs] ? 'warm' : 'measure'
      run_number = idx + 1
      puts
      puts "[#{phase}] launch #{run_number}/#{total_runs}"

      instance_id = nil
      begin
        instance_id = launch_instance(
          ec2: ec2,
          image: image,
          instance_type: instance_type,
          subnet: subnet,
          security_group_id: security_group_id,
          user_data: user_data,
          root_iops: options[:root_iops],
          root_initialization_rate: options[:root_initialization_rate],
          root_throughput: options[:root_throughput],
          root_volume_size: options[:root_volume_size]
        )
        launched_instance_ids << instance_id
        ip, elapsed, launch_time = measure_instance_ssh_ready(
          ec2: ec2,
          instance_id: instance_id,
          ssh_user: options[:ssh_user],
          private_key_path: private_key_path,
          ssh_timeout: options[:ssh_timeout]
        )
        rolaunch_status = 'ready'
        common_ready = read_common_ready_seconds(
          ip: ip,
          ssh_user: options[:ssh_user],
          private_key_path: private_key_path,
          launch_time: launch_time
        )
        rolaunch_ready = begin
          read_rolaunch_ready_seconds(
            ip: ip,
            ssh_user: options[:ssh_user],
            private_key_path: private_key_path
          )
        rescue RolaunchUnavailable
          rolaunch_status = 'absent'
          nil
        rescue StandardError => e
          rolaunch_status = 'failed'
          warn "Unable to read rolaunch readiness for #{instance_id}: #{e.message}"
          nil
        end
        initialization_status = root_volume_initialization_status(
          ec2: ec2,
          instance_id: instance_id,
          root_device_name: image.root_device_name
        )
        verify_root_volume_configuration!(
          initialization_status,
          requested_initialization_rate: options[:root_initialization_rate],
          requested_throughput: options[:root_throughput]
        )
        puts "  instance_id: #{instance_id}"
        puts "  public_ip:   #{ip}"
        puts format("  ssh_ready_s: %.2f", elapsed)
        puts format("  common_ready_s: %.3f", common_ready)
        puts format("  rolaunch_ready_s: %.2f", rolaunch_ready) if rolaunch_ready
        puts "  initialization: #{initialization_status.to_json}"
        results << {
          phase: phase,
          instance_id: instance_id,
          ip: ip,
          ssh_ready_s: elapsed,
          common_ready_s: common_ready,
          rolaunch_ready_s: rolaunch_ready,
          rolaunch_status: rolaunch_status,
          volume_initialization: initialization_status
        }
        if options[:verify_compact_recovery] && phase == 'measure' && !compact_recovery_verified
          puts '  rebooting into compact GRUB recovery...'
          compact_recovery_evidence = verify_compact_recovery!(
            ip: ip,
            ssh_user: options[:ssh_user],
            private_key_path: private_key_path,
            timeout_seconds: options[:ssh_timeout],
            expected_root_gib: options[:root_volume_size]
          )
          compact_recovery_verified = true
          puts compact_recovery_evidence.lines.map { |line| "  #{line}" }.join
        end
      ensure
        terminate_instance_and_wait(ec2, instance_id) if instance_id
      end
    end

    measured = results.select { |r| r[:phase] == 'measure' }
    average = measured.sum { |r| r[:ssh_ready_s] } / measured.length
    common_ready_values = measured.map { |result| result[:common_ready_s] }
    rolaunch_summary = summarize_rolaunch_measurements(measured)

    summary = {
      ami_id: image.image_id,
      ami_name: image.name,
      instance_type: instance_type,
      subnet_id: subnet.subnet_id,
      warm_runs: options[:warm_runs],
      measured_runs: options[:measure_runs],
      root_initialization_rate_mibps: options[:root_initialization_rate],
      root_iops: options[:root_iops],
      root_throughput_mibps: options[:root_throughput],
      root_volume_size_gib: options[:root_volume_size],
      average_ssh_ready_s: average.round(2),
      average_common_ready_s: (common_ready_values.sum / common_ready_values.length).round(3),
      max_common_ready_s: common_ready_values.max.round(3),
      rolaunch_expected: rolaunch_summary[:expected],
      rolaunch_measurement_complete: rolaunch_summary[:complete],
      rolaunch_measured_runs: rolaunch_summary[:values].length,
      average_rolaunch_ready_s: rolaunch_summary[:average],
      max_rolaunch_ready_s: rolaunch_summary[:maximum],
      compact_recovery_verified: compact_recovery_verified,
      compact_recovery_evidence: compact_recovery_evidence,
      results: results
    }

    output = JSON.pretty_generate(summary)
    puts
    puts output
    File.write(options[:output_json], "#{output}\n") if options[:output_json]

    verify_rolaunch_benchmark!(
      results: results,
      warm_runs: options[:warm_runs],
      measure_runs: options[:measure_runs],
      average_at_most: options[:require_average_rolaunch_ready_at_most],
      max_below: options[:require_max_rolaunch_ready_below]
    )

    unless rolaunch_summary[:complete]
      raise "Incomplete rolaunch readiness: #{rolaunch_summary[:values].length}/#{measured.length} measured launches produced rolaunch.done"
    end
  ensure
    original_error = $!
    cleanup_errors = cleanup_instances(ec2, launched_instance_ids)

    begin
      delete_security_group_with_retry(ec2, security_group_id)
    rescue Aws::EC2::Errors::ServiceError => e
      cleanup_errors << "failed to delete temporary security group #{security_group_id}: #{e.message}"
    end

    unless cleanup_errors.empty?
      message = "Cleanup incomplete: #{cleanup_errors.join('; ')}"
      warn message
      raise message unless original_error
    end
  end
end
