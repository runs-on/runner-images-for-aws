#!/usr/bin/env ruby

require "open3"
require "yaml"

lock_path = File.expand_path("../upstream.lock.yml", __dir__)
lock = YAML.safe_load_file(lock_path)
repository = lock.fetch("repository")
ref = lock.fetch("ref")

output, error, status = Open3.capture3("git", "ls-remote", repository, ref)
fail("Failed to resolve #{repository}: #{error}") unless status.success?

revision = output.split.first
fail("No revision found for #{repository} #{ref}") unless revision&.match?(/\A[0-9a-f]{40}\z/)

File.write(lock_path, { "repository" => repository, "ref" => ref, "revision" => revision }.to_yaml)
puts "Locked #{repository} at #{revision}"
