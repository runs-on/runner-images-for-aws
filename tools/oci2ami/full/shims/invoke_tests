#!/bin/bash
# Runs runner-images' Pester tests like upstream, but records a failure
# instead of failing the build: some tests check what only a booted machine
# has (running services, the kernel, the boot loader). The list is in
# /imagegeneration/oci-test-failures.txt.
if ! /imagegeneration/helpers/invoke-tests.sh "$@"; then
  echo "$*" >> /imagegeneration/oci-test-failures.txt
fi
exit 0
